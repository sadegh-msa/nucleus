{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "angular-cli": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "@angular/cli", "mcp"]
    },
    "nx": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "nx", "mcp"]
    },
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "@playwright/mcp@latest"]
    },
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": ["/home/sadegh/.local/bin/codebase-memory-mcp"]
    },
    "sequential-thinking": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    }
  }
}
