{
  "name": "nucleus",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/nucleus/src",
  "i18n": {
    "sourceLocale": {
      "code": "en-US",
      "baseHref": "en-US/"
    },
    "locales": {
      "fa": {
        "translation": "apps/nucleus/src/locales/messages.fa.json",
        "baseHref": "fa/"
      }
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/nucleus",
        "index": "apps/nucleus/src/index.html",
        "browser": "apps/nucleus/src/main.ts",
        "polyfills": ["@angular/localize/init"],
        "tsConfig": "apps/nucleus/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "input": "libs/theme/src/assets",
            "glob": "**/*"
          },
          {
            "glob": "**/*",
            "input": "apps/nucleus/public"
          }
        ],
        "styles": [
          {
            "input": "libs/ui/src/lib/ext/styles/ui.scss",
            "bundleName": "ui"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/utilities/index.scss",
            "bundleName": "utilities"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/bubble.scss",
            "bundleName": "bubble"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/button.scss",
            "bundleName": "button"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/card.scss",
            "bundleName": "card"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/checkbox.scss",
            "bundleName": "checkbox"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/form.scss",
            "bundleName": "form"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/icon.scss",
            "bundleName": "icon"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/link.scss",
            "bundleName": "link"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/list.scss",
            "bundleName": "list"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/menu.scss",
            "bundleName": "menu"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/message.scss",
            "bundleName": "message"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/popover.scss",
            "bundleName": "popover"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/ripple.scss",
            "bundleName": "ripple"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/text.scss",
            "bundleName": "text"
          },
          {
            "input": "libs/ui/src/lib/ext/styles/layers/components/toggle.scss",
            "bundleName": "toggle"
          },
          {
            "input": "libs/auth/src/lib/ext/styles/index.scss",
            "bundleName": "auth"
          },
          {
            "input": "libs/panel/src/lib/ext/styles/index.scss",
            "bundleName": "panel"
          },
          {
            "input": "libs/crud/src/lib/ext/styles/index.scss",
            "bundleName": "crud"
          },
          {
            "input": "libs/theme/src/lib/ext/styles/variables.scss",
            "bundleName": "variables"
          },
          {
            "input": "libs/theme/src/lib/ext/styles/fonts/index.scss",
            "bundleName": "fonts"
          },
          "apps/nucleus/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/ui/src/lib/ext/styles"]
        },
        "scripts": [],
        "localize": false,
        "i18nMissingTranslation": "warning"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/nucleus/src/environments/environment.ts",
              "with": "apps/nucleus/src/environments/environment.development.ts"
            }
          ]
        },
        "en-US": {
          "localize": ["en-US"],
          "fileReplacements": [
            {
              "replace": "apps/nucleus/src/environments/environment.ts",
              "with": "apps/nucleus/src/environments/environment.en-US.ts"
            }
          ]
        },
        "fa": {
          "localize": ["fa"],
          "fileReplacements": [
            {
              "replace": "apps/nucleus/src/environments/environment.ts",
              "with": "apps/nucleus/src/environments/environment.fa.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "nucleus:build:production"
        },
        "development": {
          "buildTarget": "nucleus:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "nucleus:build",
        "format": "json",
        "outputPath": "apps/nucleus/src/locales"
      }
    },
    "test": {
      "options": {}
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "nucleus:build",
        "port": 4200,
        "staticFilePath": "dist/apps/nucleus/browser",
        "spa": true
      }
    }
  }
}
