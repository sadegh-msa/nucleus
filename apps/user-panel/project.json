{
  "name": "user-panel",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/user-panel/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/user-panel",
        "index": "apps/user-panel/src/index.html",
        "browser": "apps/user-panel/src/main.ts",
        "polyfills": [
          "zone.js",
          "@angular/localize/init"
        ],
        "tsConfig": "apps/user-panel/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "input": "libs/theme/src/assets",
            "glob": "**/*"
          },
          {
            "glob": "**/*",
            "input": "apps/user-panel/public"
          }
        ],
        "styles": [
          "apps/user-panel/src/styles.scss"
        ],
        "scripts": [],
        "localize": false,
        "i18nMissingTranslation": "warning",
        "server": "apps/user-panel/src/main.server.ts",
        "prerender": true,
        "ssr": {
          "entry": "apps/user-panel/server.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/user-panel/src/environments/environment.ts",
              "with": "apps/user-panel/src/environments/environment.development.ts"
            }
          ]
        },
        "en-US": {
          "localize": [
            "en-US"
          ],
          "fileReplacements": [
            {
              "replace": "apps/user-panel/src/environments/environment.ts",
              "with": "apps/user-panel/src/environments/environment.en-US.ts"
            }
          ]
        },
        "fa": {
          "localize": [
            "fa"
          ],
          "fileReplacements": [
            {
              "replace": "apps/user-panel/src/environments/environment.ts",
              "with": "apps/user-panel/src/environments/environment.fa.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "user-panel:build:production,fa"
        },
        "development": {
          "buildTarget": "user-panel:build:development,fa"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "user-panel:build",
        "format": "json",
        "outputPath": "apps/user-panel/src/locales"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/user-panel/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "user-panel:build",
        "port": 4200,
        "staticFilePath": "dist/apps/user-panel/browser",
        "spa": true
      }
    }
  },
  "i18n": {
    "sourceLocale": {
      "code": "en-US",
      "baseHref": "en-US/"
    },
    "locales": {
      "fa": {
        "translation": "apps/user-panel/src/locales/messages.fa.json",
        "baseHref": "fa/"
      }
    }
  }
}
