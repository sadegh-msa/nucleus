  "license": "MIT",
  "scripts": {
    "reset": "nx reset",
    "start": "nx serve nucleus",
    "test": "nx run-many --target=test --all",
    "e2e": "nx run nucleus-e2e:e2e -- --ui",
    "e2e:cli": "nx run nucleus-e2e:e2e",
    "build": "nx build --configuration=fa nucleus",
