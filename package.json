    "lint": "nx affected -t lint --batch",
    "lint:all": "nx run-many -t lint --batch",
    "cd:apps": "madge --circular --extensions ts --image apps-circular.svg ./apps",
    "cd:libs": "madge --circular --extensions ts --image libs-circular.svg ./libs"
  },
  "private": true,
