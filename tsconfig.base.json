{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declarationMap": true,
    "paths": {
      "@libs/*": ["./libs/*"],
      "@styles/*": ["./styles/*"],
      "@nucleus/app": ["./src/apps/nucleus/src/app/*"],
      "@nucleus/e2e": ["./src/apps/nucleus-e2e/src/app/*"],
      "@nucleus/common": ["./libs/common/src/index.ts"],
      "@nucleus/core/auth": ["./libs/core/src/lib/ext/auth/index.ts"],
      "@nucleus/core/crud": ["./libs/core/src/lib/ext/crud/index.ts"],
      "@nucleus/core/store": ["./libs/core/src/lib/ext/store/index.ts"],
      "@nucleus/ui": ["./libs/ui/src/index.ts"],
      "@nucleus/l10n": ["./libs/l10n/src/index.ts"],
      "@nucleus/panel": ["./libs/panel/src/index.ts"],
      "@nucleus/theme": ["./libs/theme/src/index.ts"],
      "@test-mocks": ["./utils/test-mocks.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
